\defbeamertemplate{footline}{progress bar}{
	\dimen0=\paperwidth
	\multiply\dimen0 by \insertframenumber
	\divide\dimen0 by \inserttotalframenumber
	\edef\progressbarwidth{\the\dimen0}
	\leavevmode%
	\ifnum\theframenumber=1
	\else
		\begin{beamercolorbox}[wd=\paperwidth,ht=2pt,dp=1pt]{progress bar}
			\begin{beamercolorbox}[wd=\progressbarwidth,ht=2pt,dp=1pt]{progress bar progress}
			\end{beamercolorbox}%
			% \usebeamerfont{footline}\insertframenumber
		\end{beamercolorbox}%
	\fi
}

\setbeamertemplate{footline}[progress bar]

% style of sections and subsections in ToCs
\setbeamertemplate{section in toc}{
	$\blacktriangleright$~\inserttocsection
}
\setbeamertemplate{subsection in toc}{\hspace{1.5em}$\triangleright$~\inserttocsubsection}
\setbeamertemplate{frametitle continuation}{}

% begin of sections
\AtBeginSection[]
{
	\begingroup
	\begin{frame}{Contents}{}
		\begin{picture}(0,0)
			\put(-28.5,-143){\includegraphics[width=\paperwidth]{source/background1.png}}
			% we offer 5 options for background
			% if you want the box to be set in center, use -143, if not, use -137 in \put()
		\end{picture}
		\begin{center}
			\begin{tcolorbox}[colback=ucasblue!5!white,colframe=ucasblue!75!black,width=8cm]
				\tableofcontents[currentsection]
			\end{tcolorbox}
		\end{center}
	\end{frame}
	\endgroup
}

% begin of subsections
\AtBeginSubsection[]
{
	\begingroup
	\begin{frame}{Contents}{}
		\begin{picture}(0,0)
			\put(-28.5,-143){\includegraphics[width=\paperwidth]{source/background1.png}}
		\end{picture}
		\begin{center}
			\begin{tcolorbox}[colback=ucasblue!5!white,colframe=ucasblue!75!black,width=8cm]
				\tableofcontents[currentsection,currentsubsection]
			\end{tcolorbox}
		\end{center}
	\end{frame}
	\endgroup
}